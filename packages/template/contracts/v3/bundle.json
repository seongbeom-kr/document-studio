{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:document-studio:report-v3",
  "$defs": {
    "digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,79}$"
    },
    "outputFormat": {
      "enum": ["hwp", "hwpx", "docx"]
    },
    "operationId": {
      "type": "string",
      "minLength": 47,
      "maxLength": 47,
      "pattern": "^report_[0-9a-f]{40}$"
    },
    "identity": {
      "type": "object",
      "properties": {
        "sourceHash": {
          "$ref": "#/$defs/digest"
        },
        "normalizedHash": {
          "$ref": "#/$defs/digest"
        },
        "structureRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["sourceHash", "normalizedHash", "structureRevision"],
      "additionalProperties": false
    },
    "address": {
      "type": "object",
      "properties": {
        "part": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "maxItems": 64
        }
      },
      "required": ["part", "path"],
      "additionalProperties": false
    },
    "textRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        }
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "sourceRun": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40000
        },
        "styleId": {
          "$ref": "#/$defs/id"
        }
      },
      "required": ["start", "end", "styleId"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "rowChanges": {
          "type": "boolean"
        },
        "columnChanges": {
          "type": "boolean"
        },
        "merges": {
          "type": "boolean"
        },
        "paragraphRepeat": {
          "type": "boolean"
        }
      },
      "required": ["rowChanges", "columnChanges", "merges", "paragraphRepeat"],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "marginTop": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "marginRight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "marginBottom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "marginLeft": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "orientation": {
          "enum": ["portrait", "landscape"]
        }
      },
      "required": [
        "width",
        "height",
        "marginTop",
        "marginRight",
        "marginBottom",
        "marginLeft",
        "orientation"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["paragraph", "run", "cell", "table", "section"]
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4096
          },
          "maxProperties": 200
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        }
      },
      "required": ["id", "kind", "digest", "properties"],
      "additionalProperties": false
    },
    "sourceCell": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "columnSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "styleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "address",
        "row",
        "column",
        "rowSpan",
        "columnSpan",
        "text",
        "styleIds"
      ],
      "additionalProperties": false
    },
    "sourceRow": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceCell"
          },
          "maxItems": 64
        }
      },
      "required": ["id", "cells"],
      "additionalProperties": false
    },
    "sourceColumn": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "required": ["key", "width"],
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "properties": {
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRow"
          },
          "maxItems": 1000
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceColumn"
          },
          "maxItems": 64
        },
        "headerRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "styleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 200
        }
      },
      "required": ["rows", "columns", "headerRows", "styleIds"],
      "additionalProperties": false
    },
    "sourceRegion": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["text", "table", "paragraphRepeat"]
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "styleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 200
        },
        "editable": {
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/$defs/capabilities"
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "parentId": {
          "$ref": "#/$defs/id"
        },
        "textRuns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRun"
          },
          "maxItems": 20000
        }
      },
      "required": [
        "id",
        "kind",
        "address",
        "text",
        "styleIds",
        "editable",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "structure": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "format": {
          "enum": ["docx", "hwpx"]
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRegion"
          },
          "maxItems": 10000
        },
        "styles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/style"
          },
          "maxItems": 10000
        },
        "page": {
          "$ref": "#/$defs/page"
        },
        "protectedParts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/digest"
          },
          "maxProperties": 10000
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1000
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "format",
        "regions",
        "styles",
        "page",
        "protectedParts",
        "warnings"
      ],
      "additionalProperties": false
    },
    "intent": {
      "type": "object",
      "properties": {
        "purpose": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "maxItems": 500
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "maxItems": 200
        },
        "tone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "instructions": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "fixedText": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          },
          "maxItems": 200
        }
      },
      "required": [
        "purpose",
        "sources",
        "include",
        "exclude",
        "tone",
        "instructions",
        "fixedText"
      ],
      "additionalProperties": false
    },
    "regionPolicy": {
      "type": "object",
      "properties": {
        "allowRowChanges": {
          "type": "boolean"
        },
        "allowColumnChanges": {
          "type": "boolean"
        },
        "allowMerges": {
          "type": "boolean"
        },
        "allowParagraphRepeat": {
          "type": "boolean"
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "minColumnWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "empty": {
          "enum": ["remove", "keep", "blank"]
        }
      },
      "required": [
        "allowRowChanges",
        "allowColumnChanges",
        "allowMerges",
        "allowParagraphRepeat",
        "maxRows",
        "maxColumns",
        "minColumnWidth",
        "empty"
      ],
      "additionalProperties": false
    },
    "columnRole": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "prototypeColumn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "styleId": {
          "$ref": "#/$defs/id"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "repeatable": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "label",
        "prototypeColumn",
        "styleId",
        "minWidth",
        "repeatable"
      ],
      "additionalProperties": false
    },
    "regionDefinition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "sourceRegionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": ["text", "table", "paragraphRepeat"]
        },
        "enabled": {
          "type": "boolean"
        },
        "intent": {
          "$ref": "#/$defs/intent"
        },
        "reviewState": {
          "enum": ["unreviewed", "confirmed", "needs-review"]
        },
        "reviewDigest": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "styleIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 200
        },
        "policy": {
          "$ref": "#/$defs/regionPolicy"
        },
        "columnRoles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/columnRole"
          },
          "maxItems": 64
        },
        "headerRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "prototypeRow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "inputKey": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1024
        },
        "fieldProvenance": {
          "type": "object",
          "additionalProperties": {
            "enum": ["ai", "user"]
          },
          "maxProperties": 200
        },
        "range": {
          "$ref": "#/$defs/textRange"
        }
      },
      "required": [
        "id",
        "sourceRegionId",
        "kind",
        "enabled",
        "intent",
        "reviewState",
        "reviewDigest",
        "styleIds",
        "policy",
        "columnRoles"
      ],
      "additionalProperties": false
    },
    "outputSettings": {
      "type": "object",
      "properties": {
        "defaultFormat": {
          "$ref": "#/$defs/outputFormat"
        },
        "allowedFormats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputFormat"
          },
          "maxItems": 3,
          "minItems": 1,
          "uniqueItems": true
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180
        }
      },
      "required": ["defaultFormat", "allowedFormats"],
      "additionalProperties": false
    },
    "definition": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/regionDefinition"
          },
          "maxItems": 1000
        },
        "inputSchema": {
          "type": "object"
        },
        "output": {
          "$ref": "#/$defs/outputSettings"
        },
        "policy": {
          "type": "object",
          "properties": {
            "pageSize": {
              "const": "preserve"
            },
            "orientation": {
              "const": "preserve"
            },
            "fontSize": {
              "const": "preserve"
            }
          },
          "required": ["pageSize", "orientation", "fontSize"],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "regions",
        "inputSchema",
        "output",
        "policy"
      ],
      "additionalProperties": false
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "maxItems": 500,
      "uniqueItems": true
    },
    "textPlan": {
      "type": "object",
      "properties": {
        "regionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": ["regionId", "kind", "text", "evidenceRefs"],
      "additionalProperties": false
    },
    "columnPlan": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "roleId": {
          "$ref": "#/$defs/id"
        },
        "dataKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "styleId": {
          "$ref": "#/$defs/id"
        },
        "widthWeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": ["key", "roleId", "dataKey", "styleId", "widthWeight"],
      "additionalProperties": false
    },
    "cellPlan": {
      "type": "object",
      "properties": {
        "columnKey": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": ["columnKey", "text", "evidenceRefs"],
      "additionalProperties": false
    },
    "rowPlan": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "groupKey": {
          "type": "string",
          "minLength": 0,
          "maxLength": 256
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cellPlan"
          },
          "maxItems": 64
        }
      },
      "required": ["key", "groupKey", "cells"],
      "additionalProperties": false
    },
    "merge": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 999
        },
        "column": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "rowSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "columnSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      },
      "required": ["row", "column", "rowSpan", "columnSpan"],
      "additionalProperties": false
    },
    "tablePlan": {
      "type": "object",
      "properties": {
        "regionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/columnPlan"
          },
          "maxItems": 64,
          "minItems": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rowPlan"
          },
          "maxItems": 1000
        },
        "merges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/merge"
          },
          "maxItems": 64000
        }
      },
      "required": ["regionId", "kind", "columns", "rows", "merges"],
      "additionalProperties": false
    },
    "paragraphItem": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20000
        },
        "evidenceRefs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "required": ["key", "text", "evidenceRefs"],
      "additionalProperties": false
    },
    "paragraphPlan": {
      "type": "object",
      "properties": {
        "regionId": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "const": "paragraphRepeat"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/paragraphItem"
          },
          "maxItems": 1000
        }
      },
      "required": ["regionId", "kind", "items"],
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 3
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "definitionDigest": {
          "$ref": "#/$defs/digest"
        },
        "inputDigest": {
          "$ref": "#/$defs/digest"
        },
        "sourceSnapshotDigest": {
          "$ref": "#/$defs/digest"
        },
        "regions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/textPlan"
              },
              {
                "$ref": "#/$defs/tablePlan"
              },
              {
                "$ref": "#/$defs/paragraphPlan"
              }
            ]
          },
          "maxItems": 1000
        }
      },
      "required": [
        "schemaVersion",
        "identity",
        "definitionDigest",
        "inputDigest",
        "sourceSnapshotDigest",
        "regions"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "outputFormat": {
          "$ref": "#/$defs/outputFormat"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^reports/report_[0-9a-f]{40}/[^/\\\\\\x00-\\x1f:<>\"|?*]{1,180}\\.(hwp|hwpx|docx)$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "verificationDigest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "operationId",
        "outputFormat",
        "path",
        "digest",
        "byteLength",
        "verificationDigest"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "#/$defs/operationId"
        },
        "outputFormat": {
          "$ref": "#/$defs/outputFormat"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^reports/report_[0-9a-f]{40}/[^/\\\\\\x00-\\x1f:<>\"|?*]{1,180}\\.(hwp|hwpx|docx)$"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "byteLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
