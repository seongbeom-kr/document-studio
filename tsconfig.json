{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@document-studio/core": ["./packages/core/src/index.ts"],
      "@document-studio/react": ["./packages/react/src/index.ts"],
      "@document-studio/engine-docx": ["./packages/engine-docx/src/index.tsx"],
      "@document-studio/engine-rhwp": ["./packages/engine-rhwp/src/index.tsx"]
    }
  },
  "include": [
    "packages",
    "apps/playground/src",
    "examples/sandbox-agent",
    "tests",
    "*.ts"
  ],
  "exclude": ["node_modules", ".cache", "**/dist"]
}
